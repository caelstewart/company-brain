# Database (required)
DATABASE_URL=postgresql://brain:brain@localhost:5432/company_brain

# Embeddings (required for semantic search)
OPENAI_API_KEY=sk-...

# LLM extraction fallback (optional - picks one)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY is also used for LLM if no Anthropic key

# REST API auth (optional)
BRAIN_AUTH_TOKEN=your-secret-token

# Server config
BRAIN_REST_PORT=3333
BRAIN_REST_HOST=127.0.0.1
BRAIN_GROUP_ID=default
